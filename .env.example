# Contoh variabel lingkungan SMK PLUS AT-THAHIRIN.
#
# JANGAN PERNAH mengisi nilai asli di file ini dan JANGAN commit file `.env`
# sungguhan. Nilai produksi diatur di Cloudflare:
#   - Variabel biasa: wrangler.toml [vars] / dashboard Pages → Settings → Variables and Secrets
#   - Rahasia: Secret di dashboard Pages, atau `npx wrangler pages secret put <NAMA>`
# Untuk pengembangan lokal, salin `.dev.vars.example` menjadi `.dev.vars`
# (sudah diabaikan Git) — file itulah yang dibaca `wrangler pages dev`.

# --- Rahasia (Secret di Cloudflare Pages — jangan tulis di wrangler.toml) ---

# API key Google Gemini untuk fitur AI (Modul Ajar & generate soal CBT).
GEMINI_API_KEY=

# Kunci enkripsi secret TOTP verifikasi dua langkah (2FA) staf — hardening
# Fase B. Minimal 32 karakter acak; WAJIB stabil: mengganti kunci ini
# membuat secret 2FA tersimpan tidak dapat dibuka dan staf harus
# menonaktifkan 2FA lewat administrator lalu mengaktifkannya lagi.
# Bila kosong, fitur 2FA nonaktif secara aman (login tetap seperti biasa).
TOTP_ENCRYPTION_KEY=

# Secret verifikasi Cloudflare Turnstile untuk login (hardening Fase C).
# Pasangannya TURNSTILE_SITE_KEY adalah variabel biasa (publik) di
# wrangler.toml [vars]. Keduanya kosong = Turnstile mati dan perilaku
# login persis seperti sebelumnya.
TURNSTILE_SECRET_KEY=

# Kunci bersama gateway WhatsApp lokal; harus sama persis dengan GATEWAY_KEY
# pada file .env milik whatsapp-gateway/.
WHATSAPP_GATEWAY_KEY=

# Token bersama worker sinkronisasi Google Sheets/Drive (sync-worker/).
# Diatur terpisah pada worker tersebut: npx wrangler secret put SYNC_TOKEN
SYNC_TOKEN=

# --- Variabel biasa (sudah di-set di wrangler.toml [vars], didokumentasikan di sini) ---

# Nama aplikasi & identitas sekolah untuk output backend.
APP_NAME=
SCHOOL_NAME=
SCHOOL_EMAIL_DOMAIN=

# Fitur AI: "true" mengaktifkan, model Gemini yang dipakai.
GEMINI_ENABLED=
GEMINI_MODEL=

# Site key publik Cloudflare Turnstile (variabel biasa di wrangler.toml
# [vars]). Kosong = widget tidak tampil. Secret pasangannya di bagian
# rahasia di atas (TURNSTILE_SECRET_KEY).
TURNSTILE_SITE_KEY=

# URL Web App Google Apps Script untuk sync-worker (diatur di
# sync-worker/wrangler.toml [vars], bukan rahasia — aksesnya dijaga SYNC_TOKEN).
APPS_SCRIPT_URL=

# Catatan frontend: aplikasi web tidak membaca variabel VITE_* apa pun;
# satu-satunya nilai lingkungan frontend adalah mode build bawaan Vite.
